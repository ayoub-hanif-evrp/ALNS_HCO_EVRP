{
  "seed": 42,
  "device": "cuda",
  "deterministic": false,
  "constraints": {
    "time_windows_mode": "hard_original",
    "allow_late_service": false,
    "relax_time_windows": false,
    "modify_instance_time_windows": false
  },
  "dataset": {
    "path": "dataset/Schneider/evrptw_instances",
    "class_filter": [
      "RC"
    ],
    "train_size_filter": [
      "_21"
    ],
    "eval_size_filter": [
      "_21"
    ],
    "auto_discover_rc21": true,
    "expected_train_count": 13,
    "expected_eval_count": 3,
    "fail_if_train_count_mismatch": true,
    "eval_instances": [
      "rc101_21",
      "rc104_21",
      "rc208_21"
    ]
  },
  "optimizer": {
    "actor_lr": 0.0001,
    "critic_lr": 0.0001
  },
  "training": {
    "method": "actor_critic",
    "learning_rate": 0.0001,
    "entropy_coef": 0.01,
    "grad_clip": 1.0,
    "batch_size": 1,
    "cycles": 100,
    "shuffle_within_pass": false,
    "reward_scale": 1000.0,
    "log_every": 1,
    "checkpoint_every": 0,
    "dashboard_ma_window": 20,
    "min_decisions_warn": 10,
    "use_amp": false,
    "gradient_accumulation_steps": 1,
    "use_local_search_in_training": false,
    "critic_warmup_steps": 0,
    "critic_updates_per_step": 1,
    "debug_overfit_one_instance": false,
    "overfit_instance_name": "rc102_21",
    "debug_overfit_updates": 500,
    "fail_on_overfit_regression": true,
    "generate_static_dashboard": true
  },
  "rl": {
    "use_step_rewards": true,
    "use_gae": true,
    "use_counterfactual_critic": false,
    "use_pomo": false,
    "use_potential_shaping": false,
    "gamma": 1.0,
    "gae_lambda": 0.95,
    "normalize_advantages": true,
    "normalize_returns_for_critic": false,
    "critic_coef": 0.5,
    "use_served_customer_bonus": true,
    "served_bonus_mode": "penalty_equivalent",
    "served_bonus_coef": 0.5,
    "use_urgency_bonus": true,
    "urgency_bonus_coef": 0.5,
    "use_newly_expired_customer_penalty": true,
    "newly_expired_customer_penalty": 1.0,
    "use_time_waste_penalty": true,
    "time_waste_penalty_coef": 0.05,
    "time_waste_scale": 1.0,
    "use_unnecessary_station_penalty": true,
    "unnecessary_station_penalty": 1.0,
    "use_early_depot_penalty": true,
    "early_depot_penalty_coef": 2.0,
    "use_step_penalty": false,
    "step_penalty": 0.01,
    "use_urgent_customer_rank_penalty": true,
    "urgent_rank_penalty_coef": 0.2,
    "urgent_rank_k": 10,
    "use_customer_priority_logit_bias": true,
    "customer_logit_bonus": 1.0,
    "unnecessary_station_logit_penalty": 1.5,
    "use_depot_logit_penalty": true,
    "depot_logit_penalty": 2.0,
    "depot_penalty_until_served_ratio": 0.95,
    "terminal_penalty_schedule": {
      "enabled": true,
      "start_coef": 0.25,
      "end_coef": 1.0,
      "warmup_cycles": 20
    },
    "q_eval_mode": "topk",
    "max_q_actions": 64,
    "detach_critic_inputs": true
  },
  "model": {
    "embedding_dim": 192,
    "encoder_layers": 4,
    "heads": 8,
    "feedforward_dim": 768,
    "dropout": 0.1,
    "use_ev_communication": true,
    "use_edge_aware_encoder": false
  },
  "decoding": {
    "mode": "sampling",
    "multi_sample_n": 16,
    "max_steps_factor": 10
  },
  "problem": {
    "load_capacity": 100.0,
    "allow_partial_charging": true,
    "charging_portions": [
      0.25,
      0.5,
      0.75,
      1.0
    ],
    "station_reusable": true,
    "use_depot_charging": true,
    "use_horizon_check": true
  },
  "cost": {
    "lambda_vehicle": 1000.0,
    "lambda_distance": 1.0,
    "lambda_duration": 0.1,
    "lambda_charging": 0.5,
    "lambda_charging_price": 1.0,
    "lambda_waiting": 0.1,
    "penalty_unserved": 10000.0,
    "penalty_duplicate": 10000.0,
    "penalty_late": 5000.0,
    "penalty_battery": 10000.0,
    "penalty_capacity": 10000.0,
    "penalty_depot": 10000.0,
    "penalty_infeasible": 100000.0,
    "penalty_reserved": 10000.0
  },
  "fleet_search": {
    "enabled": true,
    "extra_margin": 6,
    "selection_mode": "hierarchical"
  },
  "debug": {
    "objective_mismatch_warn_threshold": 0.05,
    "fail_on_large_objective_mismatch": false,
    "allow_all_advanced_modules": false
  },
  "outputs": {
    "root": "outputs",
    "checkpoints": "outputs/checkpoints",
    "figures": "outputs/figures",
    "logs": "outputs/logs",
    "results": "outputs/results",
    "routes": "outputs/routes",
    "traces": "outputs/traces"
  },
  "dashboard": {
    "save_representative_traces": true,
    "num_random_solution_maps": 1,
    "include_best_final_cycle": true,
    "include_worst_final_cycle": true,
    "include_best_overall": true
  }
}