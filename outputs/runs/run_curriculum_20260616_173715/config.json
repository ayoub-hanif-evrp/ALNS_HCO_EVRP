{
  "seed": 42,
  "device": "cuda",
  "deterministic": false,
  "dataset": {
    "path": "dataset/converted_hanif_data",
    "train_ratio": 0.8,
    "train_size_filter": null,
    "eval_size_filter": null
  },
  "problem": {
    "load_capacity": null,
    "allow_partial_charging": true,
    "charging_portions": [
      0.25,
      0.5,
      0.75,
      1.0
    ],
    "station_reusable": true,
    "use_depot_charging": true,
    "use_horizon_check": true
  },
  "fleet_search": {
    "enabled": true,
    "extra_margin": 12,
    "selection_mode": "hierarchical"
  },
  "model": {
    "embedding_dim": 192,
    "encoder_layers": 4,
    "heads": 8,
    "feedforward_dim": 768,
    "dropout": 0.1,
    "use_ev_communication": true
  },
  "training": {
    "method": "reinforce",
    "batch_size": 1,
    "learning_rate": 0.0001,
    "entropy_coef": 0.01,
    "grad_clip": 1.0,
    "baseline": "moving_average",
    "baseline_beta": 0.9,
    "reward_scale": 1000.0,
    "normalize_advantage": true,
    "served_progress_bonus": 50.0,
    "early_stop_patience": 8,
    "early_stop_metric": "feasibility",
    "validate_every": 20,
    "val_max_per_class": 2,
    "run_final_eval": true,
    "log_every": 1
  },
  "curriculum": {
    "mode": "progressive",
    "train_classes": [
      "C",
      "R",
      "RC"
    ],
    "class_order": [
      "C",
      "RC",
      "R"
    ],
    "cycles_small": 3,
    "cycles_full": 2,
    "cycles_by_class": {
      "C": {
        "small": 3,
        "full": 2
      },
      "RC": {
        "small": 2,
        "full": 2
      },
      "R": {
        "small": 2,
        "full": 2
      }
    },
    "shuffle_within_class": false,
    "reload_phase_checkpoint": true,
    "min_class_feasibility": {
      "C": 0.25
    },
    "gate_max_retries": 2,
    "extra_margin_by_class": {
      "C": 10,
      "RC": 12,
      "R": 12
    }
  },
  "decoding": {
    "mode": "sampling",
    "multi_sample_n": 16,
    "max_steps_factor": 12
  },
  "cost": {
    "lambda_vehicle": 1000.0,
    "lambda_distance": 1.0,
    "lambda_duration": 0.1,
    "lambda_charging": 0.5,
    "lambda_charging_price": 1.0,
    "lambda_waiting": 0.1,
    "penalty_unserved": 10000.0,
    "penalty_duplicate": 10000.0,
    "penalty_late": 5000.0,
    "penalty_battery": 10000.0,
    "penalty_capacity": 10000.0,
    "penalty_depot": 10000.0,
    "penalty_infeasible": 100000.0,
    "penalty_reserved": 10000.0
  },
  "evaluation": {
    "decoding": "greedy",
    "multi_sample_n": 16,
    "save_routes": true,
    "save_figures": true
  },
  "outputs": {
    "root": "outputs",
    "checkpoints": "outputs/checkpoints",
    "figures": "outputs/figures",
    "logs": "outputs/logs",
    "results": "outputs/results",
    "routes": "outputs/routes"
  }
}