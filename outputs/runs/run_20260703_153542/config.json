{
  "seed": 42,
  "device": "cuda",
  "deterministic": false,
  "dataset": {
    "path": "dataset/Schneider/evrptw_instances",
    "class_filter": [
      "RC"
    ],
    "train_size_filter": [
      "_21"
    ],
    "eval_size_filter": [
      "_21"
    ],
    "train_instances": [
      "rc102_21",
      "rc103_21",
      "rc105_21",
      "rc106_21",
      "rc107_21",
      "rc108_21",
      "rc201_21",
      "rc202_21",
      "rc203_21",
      "rc204_21",
      "rc205_21",
      "rc206_21",
      "rc207_21"
    ],
    "eval_instances": [
      "rc101_21",
      "rc104_21",
      "rc208_21"
    ]
  },
  "optimizer": {
    "actor_lr": 0.0001,
    "critic_lr": 5e-05
  },
  "training": {
    "method": "actor_critic",
    "learning_rate": 0.0001,
    "entropy_coef": 0.01,
    "grad_clip": 1.0,
    "batch_size": 1,
    "cycles": 50,
    "shuffle_within_pass": false,
    "reward_scale": 1000.0,
    "log_every": 1,
    "checkpoint_every": 0,
    "dashboard_ma_window": 20,
    "min_decisions_warn": 10,
    "use_amp": false,
    "gradient_accumulation_steps": 1,
    "use_local_search_in_training": false,
    "debug_overfit_one_instance": false,
    "debug_overfit_instance": "rc102_21",
    "debug_overfit_updates": 300
  },
  "rl": {
    "use_step_rewards": true,
    "use_gae": true,
    "use_counterfactual_critic": false,
    "use_pomo": false,
    "use_potential_shaping": false,
    "gamma": 1.0,
    "gae_lambda": 0.95,
    "normalize_advantages": true,
    "critic_coef": 0.5,
    "q_critic_coef": 0.5,
    "q_eval_mode": "topk",
    "max_q_actions": 64,
    "detach_critic_inputs": true
  },
  "model": {
    "embedding_dim": 192,
    "encoder_layers": 4,
    "heads": 8,
    "feedforward_dim": 768,
    "dropout": 0.1,
    "use_ev_communication": true,
    "use_edge_aware_encoder": false
  },
  "decoding": {
    "mode": "sampling",
    "multi_sample_n": 16,
    "max_steps_factor": 10
  },
  "problem": {
    "load_capacity": 100.0,
    "allow_partial_charging": true,
    "charging_portions": [
      0.25,
      0.5,
      0.75,
      1.0
    ],
    "station_reusable": true,
    "use_depot_charging": true,
    "use_horizon_check": true
  },
  "cost": {
    "lambda_vehicle": 1000.0,
    "lambda_distance": 1.0,
    "lambda_duration": 0.1,
    "lambda_charging": 0.5,
    "lambda_charging_price": 1.0,
    "lambda_waiting": 0.1,
    "penalty_unserved": 10000.0,
    "penalty_duplicate": 10000.0,
    "penalty_late": 5000.0,
    "penalty_battery": 10000.0,
    "penalty_capacity": 10000.0,
    "penalty_depot": 10000.0,
    "penalty_infeasible": 100000.0,
    "penalty_reserved": 10000.0
  },
  "fleet_search": {
    "enabled": true,
    "extra_margin": 6,
    "selection_mode": "hierarchical"
  },
  "debug": {
    "objective_mismatch_warn_threshold": 0.05,
    "fail_on_large_objective_mismatch": false,
    "allow_all_advanced_modules": false
  },
  "outputs": {
    "root": "outputs",
    "checkpoints": "outputs/checkpoints",
    "figures": "outputs/figures",
    "logs": "outputs/logs",
    "results": "outputs/results",
    "routes": "outputs/routes"
  }
}